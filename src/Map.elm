module Map exposing (Layout, Location, basicMap, standardLayout)

import Systems


type alias Location =
    ( Int, Int )


type alias Layout =
    { locations : List Location
    , homes : List Location
    , mecatol : Location
    }


type alias Map =
    List ( Location, Systems.System )


basicMap : Layout -> Map
basicMap layout =
    List.map2 Tuple.pair layout.locations Systems.systems


